<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>10th Quiz Pro - Premium</title>
    <style>
        :root {
            --bg: #0a0f1e;
            --glass: rgba(30, 41, 59, 0.7);
            --accent: #fbbf24;
            --primary: #3b82f6;
            --text: #f8fafc;
            --grad: linear-gradient(135deg, #6366f1, #a855f7);
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            background-image: radial-gradient(circle at top right, #1e1b4b, transparent), 
                              radial-gradient(circle at bottom left, #1e1b4b, transparent);
            color: var(--text);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        /* --- Screens --- */
        .screen {
            position: fixed;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: var(--bg);
            z-index: 100;
            padding: 20px;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .hidden { display: none !important; }

        /* --- Glass Cards --- */
        .card {
            background: var(--glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 30px 20px;
            border-radius: 28px;
            text-align: center;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        h1 { font-size: 2rem; margin-bottom: 10px; background: var(--grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        /* --- Stylish Buttons --- */
        .btn {
            position: relative;
            display: block;
            width: 100%;
            padding: 16px;
            margin: 15px 0;
            border: none;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 700;
            color: white;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .btn:active { transform: scale(0.95); }

        .btn-notes { background: linear-gradient(135deg, #3b82f6, #2dd4bf); }
        .btn-quiz { background: var(--grad); }

        /* --- Grid System --- */
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
        .sub-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 20px 10px;
            border-radius: 18px;
            color: white;
            font-weight: 600;
            transition: 0.3s;
        }
        .sub-btn:hover { background: rgba(255, 255, 255, 0.15); border-color: var(--primary); }

        /* --- Content Area --- */
        #content-area { width: 100%; max-width: 600px; margin-top: 80px; padding-bottom: 40px; }
        .note-box {
            background: var(--glass);
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 20px;
            border-left: 6px solid var(--primary);
            animation: slideIn 0.3s ease;
        }
        @keyframes slideIn { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }

        /* --- Quiz Elements --- */
        .option-btn {
            width: 100%;
            padding: 16px;
            margin: 10px 0;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            color: white;
            text-align: left;
            font-size: 1rem;
        }
        .correct { background: #10b981 !important; border-color: #34d399 !important; box-shadow: 0 0 15px rgba(16,185,129,0.4); }
        .wrong { background: #ef4444 !important; border-color: #f87171 !important; }

        #timer-container { position: fixed; top: 0; left: 0; width: 100%; height: 6px; background: rgba(255,255,255,0.1); z-index: 1000; }
        #timer-bar { height: 100%; background: var(--accent); width: 100%; }

        .back-nav { position: fixed; top: 15px; left: 15px; z-index: 1001; background: var(--glass); border: none; color: white; padding: 10px 18px; border-radius: 12px; font-weight: bold; backdrop-filter: blur(5px); }
    </style>
</head>
<body>

    <div id="home-screen" class="screen">
        <div class="card">
            <h1>10th Quiz Pro</h1>
            <p style="color: #94a3b8; margin-bottom: 25px;">अपनी पढ़ाई को बनाएँ मज़ेदार</p>
            <button class="btn btn-notes" onclick="setMode('Notes')">📚 नोट्स (Notes)</button>
            <button class="btn btn-quiz" onclick="setMode('Quiz')">🎮 क्विज (Quiz)</button>
        </div>
    </div>

    <div id="sub-screen" class="screen hidden">
        <div class="card">
            <h2 id="sub-title">विषय चुनें</h2>
            <div class="grid">
                <button class="sub-btn" onclick="handleSubject('Hindi')">📖 हिन्दी</button>
                <button class="sub-btn" onclick="handleSubject('English')">🔤 English</button>
                <button class="sub-btn" onclick="handleSubject('Science')">🧪 विज्ञान</button>
                <button class="sub-btn" onclick="handleSubject('Mathematics')">📐 गणित</button>
                <button class="sub-btn" onclick="handleSubject('Social Science')">🌍 सा. वि.</button>
                <button class="sub-btn" onclick="handleSubject('Sanskrit')">🕉️ संस्कृत</button>
            </div>
            <button onclick="location.reload()" style="margin-top:20px; background:none; border:none; color:#64748b; font-weight:600;">⬅ पीछे हटें</button>
        </div>
    </div>

    <div id="view-screen" class="screen hidden" style="justify-content: flex-start; overflow-y: auto;">
        <div id="timer-container" class="hidden"><div id="timer-bar"></div></div>
        <button class="back-nav" onclick="location.reload()">◀ Back</button>
        <div id="content-area"></div>
    </div>

<script>
    let mode = '', quizData = [], qIndex = 0, score = 0;

    function setMode(m) { 
        mode = m; 
        document.getElementById('home-screen').classList.add('hidden'); 
        document.getElementById('sub-screen').classList.remove('hidden'); 
    }

    async function handleSubject(sub) {
        document.getElementById('sub-screen').classList.add('hidden');
        document.getElementById('view-screen').classList.remove('hidden');
        const area = document.getElementById('content-area');
        area.innerHTML = "<div style='text-align:center; margin-top:50px;'>स्कैन हो रहा है... ✨</div>";

        if (mode === 'Notes') {
            try {
                const res = await fetch('notes_10th.json');
                const json = await res.json();
                // Check if its an array or single object
                const dataMatch = Array.isArray(json) ? json.find(d => d.subject === sub) : (json.subject === sub ? json : null);
                const notes = dataMatch ? dataMatch.data : [];
                
                if (notes.length === 0) throw "Empty";
                area.innerHTML = `<h2 style='text-align:center; color:var(--accent)'>${sub} के नोट्स</h2>`;
                notes.forEach(n => {
                    const div = document.createElement('div');
                    div.className = 'note-box';
                    div.innerHTML = `<h4 style='color:var(--primary); margin:0 0 10px 0;'>प्र. ${n.question}</h4><p style='margin:0; font-size:0.95rem; line-height:1.6;'>${n.answer.replace(/\\n\d/g, '<br>')}</p>`;
                    area.appendChild(div);
                });
            } catch(e) { area.innerHTML = "<p style='text-align:center;'>क्षमा करें, इस विषय के नोट्स नहीं मिले।</p>"; }
        } else {
            // Quiz Logic
            try {
                const res = await fetch('questions.json');
                const data = await res.json();
                quizData = data.filter(q => q.subject === sub).sort(() => 0.5 - Math.random()).slice(0, 15);
                if (quizData.length === 0) throw "Empty";
                document.getElementById('timer-container').classList.remove('hidden');
                loadQuestion();
            } catch(e) { area.innerHTML = "<p style='text-align:center;'>क्विज फाइल नहीं मिली!</p>"; }
        }
    }

    function loadQuestion() {
        if (qIndex >= quizData.length) {
            const perc = Math.round((score/quizData.length)*100);
            document.getElementById('content-area').innerHTML = `
                <div class='card' style='margin-top:50px;'>
                    <h2>शानदार! 🎉</h2>
                    <h1 style='font-size:3rem;'>${perc}%</h1>
                    <p>आपने ${quizData.length} में से ${score} सही किए।</p>
                    <button class='btn btn-notes' onclick='location.reload()'>फिर से खेलें</button>
                </div>`;
            return;
        }
        const q = quizData[qIndex];
        const area = document.getElementById('content-area');
        area.innerHTML = `
            <div style='padding:0 10px;'>
                <p style='color:var(--accent); font-weight:bold;'>प्रश्न ${qIndex+1} / ${quizData.length}</p>
                <h3 style='font-size:1.3rem; line-height:1.4;'>${q.question_hi || q.question_en}</h3>
                <div id='opts'></div>
            </div>`;
        
        q.options.forEach(opt => {
            const b = document.createElement('button');
            b.className = 'option-btn';
            b.innerText = opt;
            b.onclick = () => {
                const all = document.querySelectorAll('.option-btn');
                all.forEach(btn => btn.style.pointerEvents = 'none');
                if (opt === q.answer) { b.classList.add('correct'); score++; }
                else { b.classList.add('wrong'); }
                setTimeout(() => { qIndex++; loadQuestion(); }, 1000);
            };
            document.getElementById('opts').appendChild(b);
        });

        const bar = document.getElementById('timer-bar');
        bar.style.transition = 'none'; bar.style.width = '100%';
        setTimeout(() => { bar.style.transition = 'linear 15s'; bar.style.width = '0%'; }, 100);
    }
</script>
</body>
</html>
